# ====== متغيّرات البيئة لموقع Pilot Mobile ======
# انسخ هذا الملف إلى .env واملأ القيم (محليًا فقط).
# على Vercel: أضِف هذه المتغيّرات من Settings > Environment Variables.

# رابط قاعدة البيانات PostgreSQL.
# على Vercel: يُضاف تلقائيًا عند ربط قاعدة بيانات Postgres/Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول (غيّره لقيمة عشوائية).
JWT_SECRET="ضع-هنا-نصًا-عشوائيًا-طويلًا-جدًا-وسريًا"

# بيانات حساب لوحة التحكم (تُنشأ عند أول إقلاع).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="pilot2026"
