// Pilot Mobile — Prisma schema
// قاعدة البيانات: PostgreSQL (سحابية، تعمل على الإنترنت عبر Vercel/Neon).
// DATABASE_URL يُضبط من إعدادات Vercel (أو ملف .env محليًا).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// كود فاتورة فريد — لا يمكن استخدامه أكثر من مرة
model Invoice {
  id            String         @id @default(cuid())
  code          String         @unique
  isUsed        Boolean        @default(false)
  usedAt        DateTime?
  createdAt     DateTime       @default(now())
  participation Participation?
}

/// مشاركة عميل في عجلة الجوائز
model Participation {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  invoiceCode String   @unique
  invoice     Invoice  @relation(fields: [invoiceCode], references: [code])
  prizeId     String?
  prizeLabel  String
  ip          String?
  createdAt   DateTime @default(now())

  @@index([phone])
}

/// جائزة قابلة للتعديل من لوحة التحكم (الوزن = احتمالية الظهور)
model Prize {
  id     String  @id @default(cuid())
  label  String
  weight Int     @default(10)
  color  String  @default("#0F4C39")
  icon   String  @default("gift")
  image  String  @default("")
  order  Int     @default(0)
  active Boolean @default(true)
}

/// إعدادات الموقع القابلة للتخصيص من لوحة التحكم (صف واحد، id = 1)
model SiteSettings {
  id           Int      @id @default(1)
  logoUrl      String   @default("/logo.png")
  brandWord    String   @default("بايلوت")
  welcome      String   @default("مرحباً بك في Pilot Mobile للهواتف الذكية")
  tagline      String   @default("أحدث الهواتف الذكية والإكسسوارات الأصلية بأفضل الأسعار وأفضل خدمة في كربلاء.")
  playTitle    String   @default("جرّب حظك واربح جوائز حصرية")
  playSubtitle String   @default("أدخل بياناتك وكود فاتورتك من متجر بايلوت موبايل، ثم أدِر العجلة لتربح إحدى جوائزنا المميزة.")
  contactTitle String   @default("تفضّل بزيارتنا")
  address      String   @default("العراق - كربلاء - حي الحسين - مقابل ساحة علي الأديب")
  phone        String   @default("+9647800000000")
  phoneDisplay String   @default("0780 000 0000")
  instagram    String   @default("https://www.instagram.com/pilot_mobile")
  tiktok       String   @default("https://www.tiktok.com/@pilot_mobile6")
  maps         String   @default("https://maps.app.goo.gl/km9c9VyTsXDGQczU8")
  colorBg      String   @default("#05110c")
  colorPine    String   @default("#0f4c39")
  colorGold    String   @default("#c8a24e")
  colorCream   String   @default("#f4efe3")
  fontFamily   String   @default("Tajawal")
  updatedAt    DateTime @updatedAt
}

/// حساب مدير لوحة التحكم
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

/// سجلّ العمليات للحماية والمراجعة
model Log {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}
